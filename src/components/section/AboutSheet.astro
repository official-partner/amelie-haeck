---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div class:list={["about-sheet_wrap", className]} {...rest}>
      <div class="about-sheet_portrait rise">
        {/* The portrait's place keeps the picture's shape (4 to 5). Images are absolute, cover, centred. */}
        <slot name="portrait" />
      </div>
      <div class="about-sheet_head"><slot name="head" /></div>
      <div class="about-sheet_list"><slot /></div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* About, on the page grid (--site-columns): on a phone the statement first, then the portrait, then the three parts,
       each across both columns; from 62rem the portrait takes the first three of seven columns and the statement and the
       parts the last four, from the portrait's top */
    .about-sheet_wrap {
      inline-size: 100%;
      display: grid;
      align-content: start;
      grid-template-columns: repeat(var(--site-columns), minmax(0, 1fr));
      column-gap: var(--site-gutter);
      row-gap: var(--space-8);
      padding-block: var(--page-top) var(--page-bottom);
      @media (width >= 62rem) {
        grid-template-rows: auto 1fr;
        row-gap: var(--head-gap);
      }
    }

    .about-sheet_portrait {
      grid-column: 1 / -1;
      grid-row: 2;
      @media (width >= 62rem) {
        grid-column: 1 / span 3;
        grid-row: 1 / span 2;
      }
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: clip;
      background-color: var(--background-skeleton);
      & img {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    }

    .about-sheet_head,
    .about-sheet_list {
      grid-column: 1 / -1;
      @media (width >= 62rem) {
        grid-column: 4 / -1;
      }
    }

    .about-sheet_head {
      grid-row: 1;
    }

    .about-sheet_list {
      grid-row: 3;
      @media (width >= 62rem) {
        grid-row: 2;
      }
      /* The three parts hang from a line, each closed by its own (the accordion's border) */
      & .accordion_wrap {
        border-top: var(--border-width) solid var(--border);
      }
    }
  }
</style>
