---
import type { HTMLAttributes } from "astro/types";
import TextControl from "@/components/content/TextControl.astro";

type Film = {
  /** The project's address segment: `starbucks` leads to /videos/starbucks. */
  slug: string;
  /** The project's title, for the number's name. */
  title: string;
  /** The film for a computer (1080p). Omit and the frame stays black. */
  src?: string;
  /** The lighter film for a phone (720p). */
  srcMobile?: string;
  /** The film's first frame, behind the film while it loads. */
  poster?: string;
  /** What the first frame shows, from the project's title and client. */
  alt?: string;
};

type Props = Omit<HTMLAttributes<"section">, "title"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The films a number shows, their numbers are their places, 1 to 7. */
  films: Film[];
  /** The demo reel that plays small in the middle until a number is touched. */
  demo?: { src?: string; srcMobile?: string };
  /** Where « Play Demo » leads. */
  demoHref?: string;
};

const {
  render = true,
  films,
  demo,
  demoHref = "/videos/demo",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && films.length > 0 && (
    <section
      class:list={["reel-home_wrap theme-dark", className]}
      aria-label="Selected films"
      {...rest}
    >
      {/* The demo reel plays small in the middle. A number's film takes its place and everything grows to the full screen. Frames are made by the script when they are needed. */}
      <div class="reel-home_stage" aria-hidden="true">
        <div
          class="reel-home_frame reel-home_demo-frame"
          data-src={demo?.src}
          data-src-mobile={demo?.srcMobile ?? demo?.src}
        >
          {/* The pointer's target only: the label that follows it belongs to the mouse, the link below is for everyone else */}
          <a class="reel-home_pointer" href={demoHref} tabindex="-1" />
        </div>
        {films.map((film) => (
          <div
            class="reel-home_frame reel-home_film"
            data-src={film.src}
            data-src-mobile={film.srcMobile ?? film.src}
            data-poster={film.poster}
            data-alt={film.alt ?? ""}
          />
        ))}
      </div>

      <span
        class="reel-home_label pointer-follow text-style-main"
        aria-hidden="true"
      >
        Play Demo
      </span>

      <div class="reel-home_foot">
        <div class="reel-home_actions">
          <TextControl
            class="reel-home_demo"
            href={demoHref}
            label="Play Demo"
          />
        </div>
        <nav aria-label="Films">
          <ol class="reel-home_numbers">
            {films.map((film, i) => (
              <li class="reel-home_item">
                <a
                  class="reel-home_number text-style-display"
                  href={`/videos/${film.slug}`}
                  aria-label={`${i + 1}, ${film.title}`}
                >
                  {i + 1}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { followPointer } from "@/utils/pointer-follow.ts";

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>(
      ".reel-home_wrap",
    )) {
      // once per root: a copy made in OP System carries the attribute from its original
      if (root.dataset.scriptInitialized === "true") continue;
      root.dataset.scriptInitialized = "true";
      signal.addEventListener(
        "abort",
        () => delete root.dataset.scriptInitialized,
      );

      const demo = root.querySelector<HTMLElement>(".reel-home_demo-frame");
      const films = [...root.querySelectorAll<HTMLElement>(".reel-home_film")];
      const numbers = [
        ...root.querySelectorAll<HTMLAnchorElement>(".reel-home_number"),
      ];
      const list = root.querySelector<HTMLElement>(".reel-home_numbers");
      const pointer = root.querySelector<HTMLElement>(".reel-home_pointer");
      const label = root.querySelector<HTMLElement>(".reel-home_label");
      if (!demo || !list || films.length === 0) continue;

      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      // the current site's own break: under 992 px the demo fills the screen with its phone file
      const compact = matchMedia("(max-width: 61.99em)");

      // the film a number is showing (-1: none, the demo plays)
      let current = -1;
      // why the films hold still: the reel is off screen, the tab is hidden
      const waits = new Set<string>();

      const file = (frame: HTMLElement) =>
        (compact.matches ? frame.dataset.srcMobile : frame.dataset.src) ?? "";

      // a frame is made when it is needed: its first frame, then its file, ready to be shown
      const mount = (frame: HTMLElement) => {
        if (frame.dataset.mounted) return;
        frame.dataset.mounted = "true";
        if (frame.dataset.poster) {
          const img = new Image();
          img.className = "reel-home_poster cover-absolute";
          img.alt = frame.dataset.alt ?? "";
          img.decoding = "async";
          img.src = frame.dataset.poster;
          frame.prepend(img);
        }
        if (file(frame)) {
          const video = document.createElement("video");
          video.className = "reel-home_video cover-absolute";
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.preload = "auto";
          video.src = file(frame);
          const ready = () => {
            frame.classList.add("is-ready");
            sync();
          };
          video.addEventListener("loadeddata", ready, { once: true });
          video.addEventListener("playing", ready, { once: true });
          frame.append(video);
        }
      };

      const covered = () =>
        current >= 0 && films[current].classList.contains("is-ready");

      // the demo plays until a number's film is on it; a film plays while it is shown; none plays when motion is reduced
      const sync = () => {
        const still = reduce.matches || waits.size > 0;
        const run = (frame: HTMLElement, on: boolean) => {
          const video = frame.querySelector("video");
          if (!video) return;
          if (on && !still) video.play().catch(() => {});
          else video.pause();
        };
        run(demo, !covered());
        films.forEach((film, k) => run(film, k === current));
        root.toggleAttribute("data-covered", covered());
      };

      const show = (i: number) => {
        if (i === current) return;
        current = i;
        if (i >= 0) {
          mount(films[i]);
          const video = films[i].querySelector("video");
          if (video) video.currentTime = 0;
        }
        films.forEach((film, k) => film.classList.toggle("is-current", k === i));
        sync();
      };

      // a number under the pointer (or the keyboard): everything grows to the full screen and its film takes the demo's place
      const enter = (i: number) => {
        root.setAttribute("data-full", "");
        show(i);
      };
      const leave = () => {
        root.removeAttribute("data-full");
        show(-1);
      };

      numbers.forEach((n, i) => {
        n.addEventListener(
          "pointerenter",
          (event) => {
            if (event.pointerType === "mouse") enter(i);
          },
          { signal },
        );
        n.addEventListener(
          "focus",
          () => {
            // a tap that follows the link is not a visit to the number: the keyboard's focus is
            if (n.matches(":focus-visible")) enter(i);
          },
          { signal },
        );
        // a plain click opens the film: the film on screen is the one that grows into its page (TransitionCustom)
        n.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            if (current === i) films[i].classList.add("is-leaving");
          },
          { signal },
        );
      });
      list.addEventListener(
        "pointerleave",
        (event) => {
          if (event.pointerType === "mouse") leave();
        },
        { signal },
      );
      list.addEventListener(
        "focusout",
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !list.contains(event.relatedTarget)
          )
            leave();
        },
        { signal },
      );

      // Play Demo opens the demo; the frame on screen is the one that grows into it
      const open = (event: Event) => {
        const e = event as MouseEvent;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
          return;
        demo.classList.add("is-leaving");
      };
      pointer?.addEventListener("click", open, { signal });
      root.querySelector(".reel-home_demo")?.addEventListener("click", open, {
        signal,
      });

      // the label follows a mouse over the demo, centred on it (the fixed link stays for touch and keyboard)
      if (pointer && label) followPointer(label, pointer, signal, { x: 0, y: 0 });

      mount(demo);

      const watcher = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) waits.delete("away");
          else waits.add("away");
          sync();
        },
        { threshold: 0.1 },
      );
      watcher.observe(root);
      signal.addEventListener("abort", () => watcher.disconnect());
      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.hidden) waits.add("hidden");
          else waits.delete("hidden");
          sync();
        },
        { signal },
      );
      reduce.addEventListener("change", sync, { signal });
      compact.addEventListener(
        "change",
        () => {
          [demo, ...films].forEach((frame) => {
            const video = frame.querySelector("video");
            if (video && file(frame)) {
              const t = video.currentTime;
              video.src = file(frame);
              video.currentTime = t;
            }
          });
          sync();
        },
        { signal },
      );
      sync();
    }
  });
</script>

<style is:global>
  @layer components {
    /* The home: the demo reel plays small in the middle of the black screen; a number under the pointer grows everything to the full screen and plays its film. The one page with no scroll. */
    .reel-home_wrap {
      position: relative;
      display: grid;
      grid-template-rows: 1fr auto;
      block-size: var(--reel-height, 100svh);
      overflow: clip;
      background-color: var(--background);
      color: var(--text);
    }

    /* The stage's own size is the unit of its frames (cqw, cqh): they stay in step with the screen */
    .reel-home_stage {
      position: absolute;
      inset: 0;
      container-type: size;
      display: grid;
      place-items: center;
    }

    /* A frame is 50 % of the screen's width and 28 % of it high, as the current site's; the demo's frame opens to 55 % by 33 % under a mouse; all of them go to the full screen while a number is touched, and always under 992 px */
    .reel-home_frame {
      --frame-width: 50cqw;
      --frame-height: 28cqw;
      grid-area: 1 / 1;
      position: relative;
      inline-size: var(--frame-width);
      block-size: var(--frame-height);
      overflow: clip;
      background-color: var(--background);
      transition-property: inline-size, block-size;
      transition-duration: var(--reel-grow-duration);
      transition-timing-function: var(--reel-grow-ease);
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    .reel-home_demo-frame {
      @media (hover: hover) and (pointer: fine) {
        &:hover {
          --frame-width: 55cqw;
          --frame-height: 33cqw;
        }
      }
    }

    .reel-home_wrap[data-full] .reel-home_frame {
      inline-size: 100cqw;
      block-size: 100cqh;
    }

    @media (max-width: 61.99em) {
      .reel-home_frame {
        inline-size: 100cqw;
        block-size: 100cqh;
      }
    }

    /* A number's film shows instantly (a cut, never a dissolve) and only the one under the pointer; the demo goes once that film is ready under it */
    .reel-home_film {
      visibility: hidden;
      pointer-events: none;
      &.is-current {
        visibility: visible;
      }
    }

    .reel-home_wrap[data-covered] .reel-home_demo-frame {
      visibility: hidden;
    }

    /* The frame that carries on into its page: the one element of the router's shared transition */
    .reel-home_frame.is-leaving {
      view-transition-name: film;
    }

    .reel-home_poster,
    .reel-home_video {
      object-fit: cover;
      pointer-events: none;
    }

    /* The film arrives over its first frame once it has one (never the first frame itself) */
    .reel-home_video {
      opacity: 0;
      transition: opacity var(--duration-fast) var(--ease-smooth);
    }

    .reel-home_frame.is-ready .reel-home_video {
      opacity: 1;
    }

    /* The demo's whole frame is the link to the demo for a mouse, its pointer is the label */
    .reel-home_pointer {
      position: absolute;
      inset: 0;
      cursor: none;
      @media (hover: none) {
        cursor: pointer;
      }
    }

    /* The label stands centred on the pointer */
    .reel-home_label {
      color: var(--text);
      white-space: nowrap;
      translate: calc(var(--pointer-x, 0px) - 50%)
        calc(var(--pointer-y, 0px) - 50%);
    }

    .reel-home_foot {
      position: relative;
      z-index: 1;
      grid-row: 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      padding-block-end: calc(var(--site-margin) * 1.6);
      pointer-events: none;
      & a,
      & button {
        pointer-events: auto;
      }
    }

    .reel-home_actions {
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
    }

    /* « Play Demo » as a link for touch and keyboard: a mouse has the label that follows it, so here it only shows on focus */
    .reel-home_demo {
      @media (hover: hover) and (pointer: fine) {
        opacity: 0;
        pointer-events: none;
        &:focus-visible {
          opacity: 1;
        }
      }
    }

    /* Seven equal columns across the whole width, each number centred in its own; under the pointer the others fall back to the dimmed text */
    .reel-home_numbers {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .reel-home_number {
      display: block;
      text-align: center;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &:focus-visible {
        color: var(--text);
      }
    }

    @media (hover: hover) {
      .reel-home_numbers:hover .reel-home_number:not(:hover) {
        color: var(--text-dim);
      }
    }
    .reel-home_numbers:has(:focus-visible) .reel-home_number:not(:focus-visible) {
      color: var(--text-dim);
    }
  }
</style>
