---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type HeadingStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Heading level. */
  tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Type style. */
  variant?: HeadingStyle;
}

const {
  render = true,
  tag: Tag = "h2",
  variant = Tag,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={[
        "heading",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      {...rest}
    >
      <Fragment set:html={content} />
    </Tag>
  )
}
