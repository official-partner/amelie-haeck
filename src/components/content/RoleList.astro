---
import type { HTMLAttributes } from "astro/types";

export type Item =
  | string
  | { text: string; href: string; external?: boolean }
  | { lines: string[] };

type Props = Omit<HTMLAttributes<"dl">, "title"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** One entry for each role or label; a « \n » in the label breaks its line. */
  rows: { label: string; items: Item[] }[];
};

const { render = true, rows, class: className, ...rest } = Astro.props;
---

{
  render && rows.length > 0 && (
    <dl class:list={["role-list_wrap", className]} {...rest}>
      {rows.map((row) => (
        <div class="role-list_row">
          <dt class="role-list_label">
            {row.label.split("\n").map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </dt>
          <dd class="role-list_items">
            <ul>
              {row.items.map((item) => (
                <li>
                  {typeof item === "string" ? (
                    item
                  ) : "lines" in item ? (
                    item.lines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))
                  ) : (
                    <a
                      class="role-list_link"
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener" : undefined}
                    >
                      {item.text}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  )
}

<style is:global>
  @layer components {
    /* A role, then its names, read like end titles: the label on the left, one name under the other on the right */
    .role-list_wrap {
      display: grid;
      row-gap: var(--list-group-gap);
      margin: 0;
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      @media (width >= 62rem) {
        font-size: var(--text-small);
        line-height: var(--text-small-line-height);
      }
    }

    .role-list_row {
      display: grid;
      row-gap: var(--space-1);
      padding-block-end: var(--list-gap);
      @media (width >= 30rem) {
        grid-template-columns: 27% minmax(0, 1fr);
      }
    }

    .role-list_label,
    .role-list_items {
      margin: 0;
      min-inline-size: 0;
      overflow-wrap: anywhere;
    }

    .role-list_label {
      padding-inline-end: var(--site-margin);
    }

    .role-list_items ul {
      display: grid;
      row-gap: var(--list-gap);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .role-list_link {
      color: inherit;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }
  }
</style>
