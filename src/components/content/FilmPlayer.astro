---
import type { HTMLAttributes } from "astro/types";
import TextControl from "@/components/content/TextControl.astro";
import { uid } from "@/utils/unique-id.ts";

type Credit = {
  /** The role, as the end titles say it: `Motion Design`. */
  role: string;
  /** Who: `Amélie Haeck`. */
  name: string;
};

type Props = Omit<HTMLAttributes<"section">, "title"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The project's title, shown at the foot of the film. */
  title: string;
  /** The film's file for a computer (1080p). Omit and the poster stands alone. */
  src?: string;
  /** The film's lighter file for a phone (720p). */
  srcMobile?: string;
  /** The film's first frame: opaque from the first paint, the film fades in over it. */
  poster?: string;
  /** What the first frame shows, from the project's title and client. */
  alt?: string;
  /** The credits, one role and one name each, written once for every screen. */
  credits?: Credit[];
  /** The other part of a project in two films (Altitude Sports A and B). */
  part?: { href: string; label: string };
};

const {
  render = true,
  title,
  src,
  srcMobile,
  poster,
  alt = "",
  credits = [],
  part,
  class: className,
  ...rest
} = Astro.props;

const panel = uid("film-credits");
---

{
  render && title && (
    <section
      class:list={["film-player_wrap", className]}
      aria-label={title}
      data-film-src={src}
      data-film-src-mobile={srcMobile ?? src}
      {...rest}
    >
      {/* The film is the page: the one element the home's clicked film grows into (view-transition-name, TransitionCustom) */}
      <div class="film-player_stage">
        {poster && (
          <img
            class="film-player_poster cover-absolute"
            src={poster}
            {alt}
            fetchpriority="high"
            decoding="async"
          />
        )}
        {src && (
          <video
            class="film-player_video cover-absolute"
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
      </div>

      {credits.length > 0 && (
        <div class="film-player_credits theme-dark" id={panel} inert>
          <dl
            class="film-player_list dim-others"
            data-op-list="credits"
            data-op-source="component:FilmPlayer"
            data-op-min="1"
          >
            {credits.map((credit) => (
              <div class="film-player_credit" data-op-item>
                <dt class="film-player_role">{credit.role}</dt>
                <dd class="film-player_name">{credit.name}</dd>
              </div>
            ))}
          </dl>
          {part && (
            <a class="film-player_part" href={part.href}>
              {part.label}
            </a>
          )}
        </div>
      )}

      <div class="film-player_bar">
        <span class="film-player_progress hairline" aria-hidden="true" />
        {src && (
          <TextControl
            class="film-player_sound"
            label="Sound Off"
            labelOn="Sound On"
          />
        )}
        <p class="film-player_title">{title}</p>
        {credits.length > 0 && (
          <TextControl
            class="film-player_infos"
            label="Infos"
            plus
            aria-expanded="false"
            aria-controls={panel}
          />
        )}
      </div>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";

  /* The sound choice, kept in this browser (localStorage, never a cookie) and the same in every browser */
  const KEY = "ah:sound";
  const stored = () => {
    try {
      return localStorage.getItem(KEY) === "on";
    } catch {
      return false;
    }
  };
  const store = (on: boolean) => {
    try {
      localStorage.setItem(KEY, on ? "on" : "off");
    } catch {
      /* private mode: the choice lasts for the page only */
    }
  };

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>(
      ".film-player_wrap",
    )) {
      // once per root: a copy made in OP System carries the attribute from its original
      if (root.dataset.scriptInitialized === "true") continue;
      root.dataset.scriptInitialized = "true";
      signal.addEventListener(
        "abort",
        () => delete root.dataset.scriptInitialized,
      );

      const video = root.querySelector<HTMLVideoElement>(".film-player_video");
      const sound = root.querySelector<HTMLElement>(".film-player_sound");
      const progress = root.querySelector<HTMLElement>(".film-player_progress");
      const infos = root.querySelector<HTMLElement>(".film-player_infos");
      const credits = root.querySelector<HTMLElement>(".film-player_credits");

      // Infos: the credits come up over the film, on demand; Escape and a second press close them
      if (infos && credits) {
        const open = (on: boolean) => {
          infos.setAttribute("aria-expanded", String(on));
          credits.toggleAttribute("inert", !on);
          root.classList.toggle("is-credits", on);
        };
        infos.addEventListener(
          "click",
          () => open(infos.getAttribute("aria-expanded") !== "true"),
          { signal },
        );
        root.addEventListener(
          "keydown",
          (event) => {
            if (
              event.key === "Escape" &&
              root.classList.contains("is-credits")
            ) {
              open(false);
              infos.focus();
            }
          },
          { signal },
        );
        // OP System's review points at a credit: the panel opens to it
        root.addEventListener(
          "op:reveal",
          (event) => {
            const el = (event as CustomEvent<{ element?: unknown }>).detail
              ?.element;
            if (el instanceof Element && credits.contains(el)) open(true);
          },
          { signal },
        );
      }

      if (!video) continue;

      // the file that holds the screen: 720p on a phone, 1080p from 48em
      const phone = matchMedia("(max-width: 47.99em)");
      const file = () =>
        (phone.matches ? root.dataset.filmSrcMobile : root.dataset.filmSrc) ??
        "";
      video.src = file();
      phone.addEventListener(
        "change",
        () => {
          const t = video.currentTime;
          video.src = file();
          video.currentTime = t;
          if (visible && !document.hidden) video.play().catch(() => {});
        },
        { signal },
      );

      // the film fades in over its poster once it has a frame
      video.addEventListener(
        "playing",
        () => root.classList.add("is-playing"),
        { signal, once: true },
      );

      // plays in view, stops off screen and in a hidden tab
      let visible = true;
      const sync = () => {
        if (visible && !document.hidden) video.play().catch(() => {});
        else video.pause();
      };
      const watcher = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.25 },
      );
      watcher.observe(root);
      signal.addEventListener("abort", () => watcher.disconnect());
      document.addEventListener("visibilitychange", sync, { signal });

      // the progress line is a transform, never a width; it follows the film frame by frame
      if (progress) {
        let frame = 0;
        const paint = () => {
          const length = video.duration || 0;
          progress.style.transform = `scaleX(${length ? video.currentTime / length : 0})`;
          frame = requestAnimationFrame(paint);
        };
        video.addEventListener(
          "playing",
          () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(paint);
          },
          { signal },
        );
        video.addEventListener("pause", () => cancelAnimationFrame(frame), {
          signal,
        });
        signal.addEventListener("abort", () => cancelAnimationFrame(frame));
      }

      // the sound: off until the person turns it on; a remembered « on » waits for their first gesture
      if (sound) {
        const set = (on: boolean) => {
          video.muted = !on;
          sound.toggleAttribute("data-on", on);
        };
        sound.addEventListener(
          "click",
          () => {
            const on = video.muted;
            set(on);
            store(on);
          },
          { signal },
        );
        if (stored()) {
          if (navigator.userActivation?.hasBeenActive) set(true);
          else {
            const first = (event: Event) => {
              if (event.target instanceof Node && sound.contains(event.target))
                return;
              set(true);
            };
            document.addEventListener("pointerdown", first, {
              signal,
              once: true,
            });
            document.addEventListener("keydown", first, { signal, once: true });
          }
        }
      }
    }
  });
</script>

<style is:global>
  @layer components {
    /* The film is the page: the whole screen, controls on its foot, credits over it */
    .film-player_wrap {
      position: relative;
      display: grid;
      grid-template-rows: 1fr auto;
      min-block-size: var(--film-height, 100svh);
      overflow: clip;
      background-color: var(--background);
      color: var(--text);
    }

    .film-player_stage {
      position: absolute;
      inset: 0;
      /* Named for the router: the one element the home's film grows into (TransitionCustom) */
      view-transition-name: film;
    }

    .film-player_poster {
      object-fit: cover;
    }

    /* The film arrives over its first frame, slowly; the first frame itself is never faded */
    .film-player_video {
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-arrive);
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-fast);
      }
    }

    .film-player_wrap.is-playing .film-player_video {
      opacity: 1;
    }

    .film-player_bar {
      position: relative;
      z-index: 1;
      grid-row: 2;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      column-gap: var(--site-gutter);
      padding: var(--space-3) var(--site-margin) var(--space-3);
      &::before {
        /* a quiet ground under the white text, so it reads on any frame */
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          transparent,
          color-mix(in lab, var(--background) 60%, transparent)
        );
        pointer-events: none;
      }
    }

    .film-player_progress {
      position: absolute;
      inset: 0 var(--site-margin) auto;
      transform: scaleX(0);
    }

    .film-player_sound {
      justify-self: start;
    }

    .film-player_title {
      grid-column: 2;
      align-self: center;
      margin: 0;
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      text-align: center;
      text-wrap: balance;
    }

    .film-player_infos {
      grid-column: 3;
      justify-self: end;
    }

    /* The credits read as end titles: the role dim, the name white, over the film's own picture */
    .film-player_credits {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: var(--space-4);
      padding: var(--nav-height) var(--site-margin)
        calc(var(--space-8) + var(--space-5));
      background-color: color-mix(in lab, var(--background) 82%, transparent);
      color: var(--text);
      visibility: hidden;
      opacity: 0;
      translate: 0 var(--space-4);
      transition:
        opacity var(--duration-faster) var(--ease-smooth),
        translate var(--duration-faster) var(--ease-smooth),
        visibility var(--duration-faster) var(--ease-smooth);
    }

    .film-player_wrap.is-credits .film-player_credits {
      visibility: visible;
      opacity: 1;
      translate: 0 0;
      transition-duration: var(--open-duration);
    }

    @media (prefers-reduced-motion: reduce) {
      .film-player_credits {
        translate: 0 0;
      }
    }

    .film-player_list {
      display: grid;
      gap: var(--space-3);
      max-inline-size: 40rem;
      margin: 0;
    }

    .film-player_credit {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--site-gutter);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
    }

    .film-player_role {
      color: var(--text-2);
    }

    .film-player_name {
      margin: 0;
    }

    .film-player_part {
      align-self: flex-start;
      color: var(--text);
      font-size: var(--text-main);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }

    /* A phone: the title drops under the controls so neither is squeezed */
    @media (width < 48rem) {
      .film-player_bar {
        grid-template-columns: 1fr 1fr;
      }
      .film-player_title {
        grid-column: 1 / -1;
        grid-row: 2;
        text-align: start;
      }
      .film-player_infos {
        grid-column: 2;
      }
    }
  }
</style>
