---
import type { HTMLAttributes } from "astro/types";
import TextControl from "@/components/content/TextControl.astro";
import { uid } from "@/utils/unique-id.ts";

type Credit = {
  /** The role, as the end titles say it: `Motion Design`. */
  role: string;
  /** Who: `Amélie Haeck`. */
  name: string;
};

type Props = Omit<HTMLAttributes<"section">, "title" | "part"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The project's title, shown at the foot of the film. */
  title: string;
  /** The tag of the title: the page's one h1 on a project page, a paragraph where the page has its own. */
  as?: "h1" | "p";
  /** The film's file for a computer (1080p). Omit and the poster stands alone. */
  src?: string;
  /** The film's lighter file for a phone (720p). */
  srcMobile?: string;
  /** The film's first frame: opaque from the first paint, the film fades in over it. */
  poster?: string;
  /** What the first frame shows, from the project's title and client. */
  alt?: string;
  /** The credits, one role and one name each, written once for every screen. */
  credits?: Credit[];
  /** A line under the credits: « (For all credits go to wedge.work) ». */
  note?: { text: string; link?: { label: string; href: string }; end?: string };
  /** The other part of a project in two films (Altitude Sports A and B). */
  part?: { href: string; label: string };
  /** Where the credits come from, for OP System's Modifier (`data-op-source`): the project's file. */
  creditsSource?: string;
  /** Where the X leads when the page was not reached from this site (a link given, a reload): the list of Work. Reached from the site, it goes back to where the person came from, at the same scroll. */
  closeHref?: string;
};

const {
  render = true,
  title,
  as: Title = "h1",
  src,
  srcMobile,
  poster,
  alt = "",
  credits = [],
  note,
  part,
  creditsSource = "component:FilmPlayer",
  closeHref = "/work",
  class: className,
  ...rest
} = Astro.props;

const panel = uid("film-credits");
---

{
  render && title && (
    <section
      class:list={["film-player_wrap", className]}
      aria-label={title}
      data-film-src={src}
      data-film-src-mobile={srcMobile ?? src}
      {...rest}
    >
      {/* The film is the page: the one element the home's clicked film, or Work's clicked picture, grows into (view-transition-name, TransitionCustom) */}
      <div class="film-player_stage">
        {poster && (
          <img
            class="film-player_poster cover-absolute"
            src={poster}
            {alt}
            fetchpriority="high"
            decoding="async"
          />
        )}
        {src && (
          <video
            class="film-player_video cover-absolute"
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
      </div>

      {/* The credits' reading ground: a dark veil over the film and a subtle dark gradient rising from the foot, both arriving with the credits */}
      <div class="film-player_shade cover-absolute" aria-hidden="true" />

      {/* The film itself is the pause: a press anywhere on it, the label following the pointer */}
      {src && (
        <button
          class="film-player_toggle cover-absolute"
          type="button"
          aria-label="Pause the film"
        >
          <span class="film-player_pause pointer-follow" aria-hidden="true">
            Pause
          </span>
        </button>
      )}

      <div class="film-player_top">
        {part && (
          <a
            class="text-control_wrap film-player_part"
            href={part.href}
            data-astro-history="replace"
          >
            <span data-op-field="otherPartLabel">{part.label}</span>
          </a>
        )}
        {src && (
          <TextControl
            class="film-player_sound"
            label="Sound Off"
            labelOn="Sound On"
          />
        )}
        <a
          class="film-player_close"
          href={closeHref}
          aria-label="Close the project"
        >
          <svg viewBox="0 0 72 72" aria-hidden="true" focusable="false">
            <path d="M0 0 72 72M72 0 0 72" />
          </svg>
        </a>
      </div>

      <div class="film-player_foot">
        <div class="film-player_row">
          <Title class="film-player_title" data-op-field="title">{title}</Title>
          {credits.length > 0 && (
            <TextControl
              class="film-player_infos"
              label="Infos"
              dot
              aria-expanded="false"
              aria-controls={panel}
            />
          )}
        </div>

        {credits.length > 0 && (
          <div class="film-player_credits" id={panel} inert data-op-field="credits">
            <dl
              class="film-player_list dim-others"
              data-op-list="credits"
              data-op-source={creditsSource}
              data-op-min="1"
            >
              {credits.map((credit) => (
                <div class="film-player_credit" data-op-item>
                  <dt class="film-player_role">{credit.role}</dt>
                  <dd class="film-player_name">{credit.name}</dd>
                </div>
              ))}
            </dl>
            {note && (
              <p class="film-player_note" data-op-field="creditsNote">
                {note.text}
                {note.link && (
                  <>
                    {" "}
                    <a href={note.link.href} rel="noopener">
                      {note.link.label}
                    </a>
                  </>
                )}
                {note.end}
              </p>
            )}
          </div>
        )}
      </div>

      {/* The progress line is also the film's scrubber: a press or a drag on it moves the film, the arrows too */}
      <div
        class="film-player_progress"
        {...(src
          ? {
              role: "slider",
              tabindex: 0,
              "aria-label": "Film progress",
              "aria-valuemin": 0,
              "aria-valuemax": 100,
              "aria-valuenow": 0,
              "aria-valuetext": "0 %",
            }
          : { "aria-hidden": "true" })}
      >
        <span class="film-player_line hairline" />
        <span class="film-player_fill">
          <span class="film-player_bar" />
        </span>
      </div>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { followPointer } from "@/utils/pointer-follow.ts";

  /* The sound choice, kept in this browser (localStorage, never a cookie) and the same in every browser */
  const KEY = "ah:sound";
  const stored = () => {
    try {
      return localStorage.getItem(KEY) === "on";
    } catch {
      return false;
    }
  };
  const store = (on: boolean) => {
    try {
      localStorage.setItem(KEY, on ? "on" : "off");
    } catch {
      /* private mode: the choice lasts for the page only */
    }
  };

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>(
      ".film-player_wrap",
    )) {
      // once per root: a copy made in OP System carries the attribute from its original
      if (root.dataset.scriptInitialized === "true") continue;
      root.dataset.scriptInitialized = "true";
      signal.addEventListener(
        "abort",
        () => delete root.dataset.scriptInitialized,
      );

      const video = root.querySelector<HTMLVideoElement>(".film-player_video");
      const sound = root.querySelector<HTMLElement>(".film-player_sound");
      const bar = root.querySelector<HTMLElement>(".film-player_bar");
      const progress = root.querySelector<HTMLElement>(".film-player_progress");
      const toggle = root.querySelector<HTMLButtonElement>(
        ".film-player_toggle",
      );
      const pause = root.querySelector<HTMLElement>(".film-player_pause");
      const infos = root.querySelector<HTMLElement>(".film-player_infos");
      const credits = root.querySelector<HTMLElement>(".film-player_credits");
      const foot = root.querySelector<HTMLElement>(".film-player_foot");
      const close = root.querySelector<HTMLAnchorElement>(".film-player_close");

      // the X: back to where the person came from, at the scroll they left it (Astro keeps it in the history entry);
      // a project reached from outside (a given link, a reload that lost the history) goes to the list of Work
      const closeProject = () => {
        if ((history.state?.index ?? 0) > 0) history.back();
        else close?.click();
      };
      close?.addEventListener(
        "click",
        (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            !((history.state?.index ?? 0) > 0)
          )
            return;
          event.preventDefault();
          history.back();
        },
        { signal },
      );

      // Infos: the credits come up with the title, on demand; Escape and a second press close them
      let opened = false;
      if (infos && credits && foot) {
        // the foot rises by the credits' own height when they open (transform only)
        const measure = () =>
          foot.style.setProperty("--credits-h", `${credits.offsetHeight}px`);
        measure();
        const watcher = new ResizeObserver(measure);
        watcher.observe(credits);
        signal.addEventListener("abort", () => watcher.disconnect());

        const open = (on: boolean) => {
          opened = on;
          infos.setAttribute("aria-expanded", String(on));
          credits.toggleAttribute("inert", !on);
          root.classList.toggle("is-credits", on);
        };
        infos.addEventListener(
          "click",
          () => open(infos.getAttribute("aria-expanded") !== "true"),
          { signal },
        );
        // OP System's review points at a credit: the panel opens to it
        root.addEventListener(
          "op:reveal",
          (event) => {
            const el = (event as CustomEvent<{ element?: unknown }>).detail
              ?.element;
            if (el instanceof Element && credits.contains(el)) open(true);
          },
          { signal },
        );
        signal.addEventListener("abort", () => {
          opened = false;
        });
      }

      // Escape: the credits first, then the project itself
      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Escape" || event.defaultPrevented) return;
          if (opened && infos) {
            infos.click();
            infos.focus();
          } else if (
            root.parentElement === document.querySelector("main") &&
            !document.querySelector("dialog[open]")
          )
            closeProject();
        },
        { signal },
      );

      if (!video) continue;

      // the file that holds the screen: 720p on a phone, 1080p from 48em
      const phone = matchMedia("(max-width: 47.99em)");
      const file = () =>
        (phone.matches ? root.dataset.filmSrcMobile : root.dataset.filmSrc) ??
        "";
      video.src = file();
      phone.addEventListener(
        "change",
        () => {
          const t = video.currentTime;
          video.src = file();
          video.currentTime = t;
          if (visible && !document.hidden && !held && !scrubbing)
            video.play().catch(() => {});
        },
        { signal },
      );

      // the film fades in over its poster once it has a frame
      video.addEventListener(
        "playing",
        () => root.classList.add("is-playing"),
        { signal, once: true },
      );

      // plays in view, stops off screen and in a hidden tab, and stays stopped when the person stopped it
      let visible = true;
      let held = false;
      let scrubbing = false; // a finger or the mouse is on the progress line: the film waits under it
      const sync = () => {
        if (visible && !document.hidden && !held && !scrubbing)
          video.play().catch(() => {});
        else video.pause();
      };
      const watcher = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.25 },
      );
      watcher.observe(root);
      signal.addEventListener("abort", () => watcher.disconnect());
      document.addEventListener("visibilitychange", sync, { signal });

      // a press on the film pauses it and a second press plays it again; the label follows a mouse over the film
      if (toggle) {
        toggle.addEventListener(
          "click",
          () => {
            held = !held;
            toggle.setAttribute(
              "aria-label",
              held ? "Play the film" : "Pause the film",
            );
            root.classList.toggle("is-held", held);
            if (pause) pause.textContent = held ? "Play" : "Pause";
            sync();
          },
          { signal },
        );
        if (pause) followPointer(pause, toggle, signal, "center");
      }

      // the progress line is a transform, never a width; it follows the film frame by frame, and is also moved by the person
      if (bar) {
        let frame = 0;
        const paint = () => {
          const length = video.duration || 0;
          const at = length ? Math.min(video.currentTime / length, 1) : 0;
          bar.style.transform = `scaleX(${at})`;
          if (progress) {
            const percent = Math.round(at * 100);
            progress.setAttribute("aria-valuenow", String(percent));
            progress.setAttribute("aria-valuetext", `${percent} %`);
          }
        };
        const loop = () => {
          paint();
          frame = requestAnimationFrame(loop);
        };
        video.addEventListener(
          "playing",
          () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(loop);
          },
          { signal },
        );
        video.addEventListener(
          "pause",
          () => {
            cancelAnimationFrame(frame);
            paint();
          },
          { signal },
        );
        // paused or not yet playing, a jump of the film still moves the line
        video.addEventListener("seeked", paint, { signal });
        video.addEventListener("loadedmetadata", paint, { signal });
        signal.addEventListener("abort", () => cancelAnimationFrame(frame));

        if (progress) {
          const seek = (event: PointerEvent) => {
            const length = video.duration;
            if (!length || !Number.isFinite(length)) return;
            const box = progress.getBoundingClientRect();
            const at = Math.min(Math.max((event.clientX - box.left) / box.width, 0), 1);
            video.currentTime = at * length;
            paint();
          };
          progress.addEventListener(
            "pointerdown",
            (event) => {
              if (event.button !== 0) return;
              scrubbing = true;
              progress.setPointerCapture(event.pointerId);
              root.classList.add("is-scrubbing");
              sync();
              seek(event);
            },
            { signal },
          );
          progress.addEventListener(
            "pointermove",
            (event) => {
              if (scrubbing) seek(event);
            },
            { signal },
          );
          const release = () => {
            if (!scrubbing) return;
            scrubbing = false;
            root.classList.remove("is-scrubbing");
            sync();
          };
          progress.addEventListener("pointerup", release, { signal });
          progress.addEventListener("pointercancel", release, { signal });
          // the keyboard: arrows move by 5 s, Home and End to the ends
          progress.addEventListener(
            "keydown",
            (event) => {
              const length = video.duration;
              if (!length || !Number.isFinite(length)) return;
              const to: Record<string, number> = {
                ArrowRight: video.currentTime + 5,
                ArrowUp: video.currentTime + 5,
                ArrowLeft: video.currentTime - 5,
                ArrowDown: video.currentTime - 5,
                Home: 0,
                End: length,
              };
              if (!(event.key in to)) return;
              event.preventDefault();
              video.currentTime = Math.min(Math.max(to[event.key], 0), length);
              paint();
            },
            { signal },
          );
        }
      }

      // the sound: off until the person turns it on; a remembered « on » waits for their first gesture
      if (sound) {
        const set = (on: boolean) => {
          video.muted = !on;
          sound.toggleAttribute("data-on", on);
        };
        sound.addEventListener(
          "click",
          () => {
            const on = video.muted;
            set(on);
            store(on);
          },
          { signal },
        );
        if (stored()) {
          if (navigator.userActivation?.hasBeenActive) set(true);
          else {
            const first = (event: Event) => {
              if (event.target instanceof Node && sound.contains(event.target))
                return;
              set(true);
            };
            document.addEventListener("pointerdown", first, {
              signal,
              once: true,
            });
            document.addEventListener("keydown", first, { signal, once: true });
          }
        }
      }
    }
  });
</script>

<style is:global>
  @layer components {
    /* The film is the page: the whole screen, its title and credits low on the left, its progress line on the foot */
    .film-player_wrap {
      position: relative;
      min-block-size: var(--film-height, 100svh);
      overflow: clip;
      background-color: var(--background);
      color: var(--text);
    }

    .film-player_stage {
      position: absolute;
      inset: 0;
      background-color: var(--background);
      /* Named for the router: the one element the home's film, or Work's picture, grows into (TransitionCustom) */
      view-transition-name: film;
    }

    .film-player_poster {
      object-fit: cover;
    }

    /* The film arrives over its first frame, slowly; the first frame itself is never faded */
    .film-player_video {
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-arrive);
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-fast);
      }
    }

    .film-player_wrap.is-playing .film-player_video {
      opacity: 1;
    }

    /* Under the credits: a dark veil over the whole film and a subtle gradient deepening toward the foot, opacity only */
    .film-player_shade {
      pointer-events: none;
      opacity: 0;
      background-color: color-mix(in srgb, var(--black) 35%, transparent);
      background-image: linear-gradient(
        to bottom,
        transparent 35%,
        color-mix(in srgb, var(--black) 55%, transparent)
      );
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .film-player_wrap.is-credits .film-player_shade {
      opacity: 1;
    }

    /* A press anywhere on the film: it carries no look of its own, its label follows the pointer */
    .film-player_toggle {
      cursor: pointer;
      &:focus-visible {
        outline-offset: calc(var(--focus-offset) * -1);
      }
    }

    .film-player_pause {
      color: var(--text);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      white-space: nowrap;
    }

    /* The top right, level with the nav's words: the other part, Sound Off, and the X */
    .film-player_top {
      position: absolute;
      inset-block-start: calc(var(--site-margin) * 1.2);
      inset-inline-end: var(--film-inset);
      z-index: 2;
      display: flex;
      align-items: flex-start;
      gap: var(--space-6);
      /* a phone: under the nav's two lines, which fill the width as far as the second column */
      @media (width < 48rem) {
        inset-block-start: var(--nav-height);
        gap: var(--space-4);
      }
    }

    .film-player_top .text-control_wrap {
      min-block-size: 1.5rem;
    }

    .film-player_part {
      text-underline-offset: 0.2em;
    }

    /* The X, corner to corner of its square, drawn with the site's hairline */
    .film-player_close {
      display: block;
      flex: none;
      inline-size: var(--close-size);
      block-size: var(--close-size);
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
      & svg {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        overflow: visible;
        fill: none;
        stroke: currentcolor;
        stroke-width: var(--hairline-height);
        vector-effect: non-scaling-stroke;
      }
      & path {
        vector-effect: non-scaling-stroke;
      }
    }

    /* The title and Infos on one line; the credits hang under them. With the title alone the foot rests low; opened, it rises by the credits' height (transform only) */
    .film-player_foot {
      --credits-h: 0px;
      position: absolute;
      inset-inline: var(--film-inset);
      inset-block-end: calc(var(--film-inset) + 4vw);
      z-index: 1;
      transition: translate var(--open-duration) var(--open-ease);
      @media (width < 48rem) {
        inset-block-end: calc(var(--film-inset) + var(--space-8));
      }
    }

    .film-player_wrap.is-credits .film-player_foot {
      translate: 0 calc(var(--credits-h) * -1);
    }

    .film-player_row {
      display: grid;
      grid-template-columns: 25.5% minmax(0, 1fr);
      align-items: center;
      @media (width < 48rem) {
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: var(--site-gutter);
      }
    }

    .film-player_title {
      margin: 0;
      font-size: var(--text-main);
      font-weight: inherit;
      line-height: var(--text-main-line-height);
      text-wrap: balance;
    }

    .film-player_infos {
      justify-self: start;
      min-block-size: 1.5rem;
      @media (width < 48rem) {
        justify-self: end;
      }
    }

    /* The credits read as end titles, the role on the left and the name on the right, as About's lists */
    .film-player_credits {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      padding-block-start: var(--head-gap);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--duration-faster) var(--ease-smooth),
        visibility var(--duration-faster) var(--ease-smooth);
      @media (width < 48rem) {
        padding-block-start: var(--space-5);
      }
    }

    .film-player_wrap.is-credits .film-player_credits {
      visibility: visible;
      opacity: 1;
      transition-duration: var(--open-duration);
    }

    .film-player_list {
      display: grid;
      margin: 0;
    }

    .film-player_credit {
      display: grid;
      grid-template-columns: 25.5% minmax(0, 1fr);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      @media (width < 48rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        column-gap: var(--site-gutter);
      }
    }

    .film-player_role,
    .film-player_name {
      margin: 0;
      min-inline-size: 0;
      overflow-wrap: anywhere;
    }

    .film-player_note {
      margin: var(--list-group-gap) 0 0;
      padding-inline-start: 25.5%;
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      color: var(--text-2);
      @media (width < 48rem) {
        padding-inline-start: 0;
      }
      & a {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }

    /* The progress line: a hairline across the foot and a bar that fills it by transform, thicker while the credits are up */
    .film-player_progress {
      position: absolute;
      inset-inline: var(--film-inset);
      inset-block-end: var(--film-inset);
      z-index: 1;
      block-size: calc(var(--text-main) * 0.85);
      pointer-events: none;
    }

    /* The line is the film's scrubber: a taller reach around it (a hairline is too thin to catch), only when it is one */
    .film-player_progress[role="slider"] {
      pointer-events: auto;
      cursor: pointer;
      touch-action: none;
      &::before {
        content: "";
        position: absolute;
        inset: calc(var(--space-3) * -1) 0;
      }
      &:focus-visible {
        outline-offset: var(--space-2);
      }
    }

    /* Held by the pointer: the line is as thick as when the credits are up */
    .film-player_wrap.is-scrubbing .film-player_fill {
      scale: 1 1;
    }

    .film-player_line {
      position: absolute;
      inset: auto 0 0;
    }

    .film-player_fill {
      position: absolute;
      inset: 0;
      transform-origin: left bottom;
      scale: 1 0.25;
      transition: scale var(--open-duration) var(--open-ease);
    }

    .film-player_wrap.is-credits .film-player_fill {
      scale: 1 1;
    }

    .film-player_bar {
      display: block;
      block-size: 100%;
      background-color: currentcolor;
      transform: scaleX(0);
      transform-origin: left center;
    }

  }
</style>
