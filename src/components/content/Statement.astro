---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "title"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The statement, one entry for each line, broken by hand as the current site breaks it. */
  lines: string[];
  /** The address under it: what it shows and where it leads (`mailto:`). */
  email?: { text: string; href: string };
};

const { render = true, lines, email, class: className, ...rest } = Astro.props;
---

{
  render && lines.length > 0 && (
    <div class:list={["statement_wrap", className]} {...rest}>
      {/* The page's one h1: the About statement in red on white, its lines rising once as the page arrives */}
      <h1 class="statement_title text-style-h1">
        {lines.map((line, i) => (
          <span class="statement_line rise" style={`--i:${i}`}>
            {line}
          </span>
        ))}
      </h1>
      {email && (
        <p class="statement_email text-style-h1 rise" style={`--i:${lines.length}`}>
          <a class="statement_link" href={email.href}>
            {email.text}
          </a>
        </p>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .statement_wrap {
      display: grid;
      gap: var(--statement-gap);
    }

    /* Lines stack as a grid and the type keeps its whole line box, as the current site's, not trimmed to the capitals:
       its spaces are counted from the line's edges */
    .statement_title {
      display: grid;
      margin-block: 0;
      text-box: normal;
    }

    .statement_line {
      display: block;
    }

    /* The address is as large as the statement, as on the current site, and breaks where a phone needs it */
    .statement_email {
      margin: 0;
      text-box: normal;
      overflow-wrap: anywhere;
      /* the whole address fits one line on a phone only at the h3 size */
      @media (width < 48rem) {
        font-size: var(--h3);
        line-height: var(--h3-line-height);
      }
    }

    .statement_link {
      color: inherit;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }
  }
</style>
