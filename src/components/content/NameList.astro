---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The names, in reading order: they fill the columns from the top of the first one. */
  names: string[];
};

const { render = true, names, class: className, ...rest } = Astro.props;
---

{
  render && names.length > 0 && (
    <ul class:list={["name-list_wrap", className]} {...rest}>
      {names.map((name) => (
        <li class="name-list_item" data-op-item>
          {name}
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    /* Plain names in columns, as many as the width allows (Selected Clients) */
    .name-list_wrap {
      /* the page grid's columns: two on a phone, and the four columns the list spans from 62rem */
      columns: 2;
      column-gap: var(--site-gutter);
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      @media (width >= 62rem) {
        /* small text, six names under each other, one page column to each name column (the list spans four of them) */
        display: grid;
        grid-auto-flow: column;
        grid-template-rows: repeat(6, auto);
        grid-template-columns: repeat(4, minmax(0, 1fr));
        font-size: var(--text-small);
        line-height: var(--text-small-line-height);
      }
    }

    .name-list_item {
      break-inside: avoid;
      overflow-wrap: anywhere;
    }
  }
</style>
