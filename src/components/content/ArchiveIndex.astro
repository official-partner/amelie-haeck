---
import type { HTMLAttributes } from "astro/types";

type Row = {
  /** The year, as four digits. */
  year: string;
  /** The client. */
  client: string;
  /** The project's title. */
  project: string;
  /** The industry: written the same way on every row, so the sort keeps them together. */
  industry: string;
  /** The project's page: /videos/koho. */
  href: string;
  /** The picture that follows the pointer over the row: a short muted loop or a WebP, never a GIF. */
  thumb?: string;
  /** What the picture shows, from the project's title and client. */
  thumbAlt?: string;
};

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The projects, newest first: the order the list opens in. */
  rows: Row[];
};

const { render = true, rows, class: className, ...rest } = Astro.props;

const columns = [
  { key: "year", label: "Year" },
  { key: "client", label: "Client" },
  { key: "project", label: "Project" },
  { key: "industry", label: "Industry" },
] as const;
---

{
  render && rows.length > 0 && (
    <div class:list={["archive-index_wrap", className]} {...rest}>
      {/* Sort by a heading: every heading has its ring, filled on the one in use. Columns drop out on a small screen, as on the current site. */}
      <div
        class="archive-index_head dim-others"
        role="group"
        aria-label="Sort the list"
      >
        {columns.map((column, i) => (
          <button
            class={`archive-index_sort ${column.key}`}
            type="button"
            data-key={column.key}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            <span class="archive-index_dot" aria-hidden="true" />
            {column.label}
          </button>
        ))}
      </div>

      <ul
        class="archive-index_list dim-others"
        data-op-list="archive"
        data-op-source="component:ArchiveIndex"
      >
        {rows.map((row, i) => (
          <li class="archive-index_item rise" style={`--i:${i}`} data-op-item>
            <a
              class="archive-index_row"
              href={row.href}
              data-thumb={row.thumb}
              data-alt={row.thumbAlt}
            >
              <span class="archive-index_cell year">{row.year}</span>
              <span class="archive-index_cell client">{row.client}</span>
              <span class="archive-index_cell project">{row.project}</span>
              <span class="archive-index_cell industry">{row.industry}</span>
            </a>
          </li>
        ))}
      </ul>

      <img
        class="archive-index_thumb pointer-follow"
        alt=""
        aria-hidden="true"
      />
      <p class="sr-only" role="status" aria-live="polite" />
    </div>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { followPointer } from "@/utils/pointer-follow.ts";

  type Sort = { key: string; down: boolean };
  const KEY_DEFAULT: Sort = { key: "year", down: true }; // the list opens newest first

  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const token = (name: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const ms = (name: string) => {
    const value = token(name);
    const n = parseFloat(value) || 0;
    return /ms$/.test(value) ? n : /s$/.test(value) ? n * 1000 : n;
  };

  const text = (item: Element, k: string) =>
    item.querySelector(`.archive-index_cell.${k}`)?.textContent?.trim() ?? "";

  /* The sort of this history entry: the page is left for a project and the close (X) brings it back to the same place
     in the same order. Astro keeps its own scroll in the entry's state; the sort goes beside it. */
  const saved = (): Sort | undefined => history.state?.workSort;
  const remember = (sort: Sort) => {
    if (history.state)
      history.replaceState({ ...history.state, workSort: sort }, "");
  };

  /* The order the page was written in, kept per list: equal values stay in it */
  const written = new WeakMap<Element, Map<Element, number>>();

  /* Puts a list in the order of `sort` */
  const arrange = (list: HTMLElement, sort: Sort) => {
    if (!written.has(list))
      written.set(list, new Map([...list.children].map((item, i) => [item, i])));
    const order = written.get(list) as Map<Element, number>;
    const items = [...list.children].sort((a, b) => {
      const [x, y] = [text(a, sort.key), text(b, sort.key)];
      const by =
        sort.key === "year"
          ? Number(x) - Number(y)
          : x.localeCompare(y, undefined, { sensitivity: "base" });
      return (sort.down ? -by : by) || (order.get(a) ?? 0) - (order.get(b) ?? 0);
    });
    list.append(...items);
    return items as HTMLElement[];
  };

  const press = (root: Element, key: string) => {
    for (const sort of root.querySelectorAll(".archive-index_sort"))
      sort.setAttribute(
        "aria-pressed",
        String((sort as HTMLElement).dataset.key === key),
      );
  };

  /* Coming back to the list (the close of a project, the browser's back): the entry's own order and none of the opening
     rise, so the page is as it was left. Done as the new page is swapped in, before it is shown. */
  let navigation = "push";
  document.addEventListener("astro:before-preparation", (event) => {
    navigation = (event as Event & { navigationType?: string }).navigationType ?? "push";
  });
  const restore = (traversed: boolean) => {
    const sort = saved();
    for (const root of document.querySelectorAll<HTMLElement>(".archive-index_wrap")) {
      const list = root.querySelector<HTMLElement>(".archive-index_list");
      if (!list) continue;
      if (traversed) root.setAttribute("data-settled", "");
      if (sort) {
        arrange(list, sort);
        press(root, sort.key);
      }
    }
  };
  document.addEventListener("astro:after-swap", () => {
    restore(navigation === "traverse");
    navigation = "push";
  });

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>(
      ".archive-index_wrap",
    )) {
      // once per root: a copy made in OP System carries the attribute from its original
      if (root.dataset.scriptInitialized === "true") continue;
      root.dataset.scriptInitialized = "true";
      signal.addEventListener(
        "abort",
        () => delete root.dataset.scriptInitialized,
      );

      const list = root.querySelector<HTMLElement>(".archive-index_list");
      const sorts = [
        ...root.querySelectorAll<HTMLButtonElement>(".archive-index_sort"),
      ];
      const thumb = root.querySelector<HTMLImageElement>(
        ".archive-index_thumb",
      );
      const status = root.querySelector<HTMLElement>("[role=status]");
      if (!list) continue;

      // a page loaded straight (a reload, a first visit that landed here): the entry's order if it has one
      let current: Sort = saved() ?? { ...KEY_DEFAULT };
      arrange(list, current);
      press(root, current.key);
      remember(current);

      // job: sort the list by the heading pressed; a second press on the same heading reverses it, and the list fades out and back in with the rows in their new places
      const names: Record<string, [string, string]> = {
        year: ["newest first", "oldest first"],
        client: ["A to Z", "Z to A"],
        project: ["A to Z", "Z to A"],
        industry: ["A to Z", "Z to A"],
      };
      // the list fades out, the rows change places while it is clear, and it fades back in (opacity only, nothing travels)
      let fade: Animation | undefined;
      let sorting = 0;
      for (const sort of sorts) {
        sort.addEventListener(
          "click",
          () => {
            const next = sort.dataset.key ?? "year";
            current = {
              key: next,
              down: next === current.key ? !current.down : next === "year",
            };
            root.setAttribute("data-settled", "");
            press(root, current.key);
            remember(current);
            if (status)
              status.textContent = `Sorted by ${sort.textContent?.trim()}, ${names[current.key][current.down ? 0 : 1]}`;

            fade?.cancel();
            if (reduce.matches) {
              arrange(list, current);
              return;
            }
            const run = ++sorting;
            const easing = token("--ease-smooth") || "ease-out";
            fade = list.animate(
              [{ opacity: getComputedStyle(list).opacity }, { opacity: 0 }],
              { duration: ms("--duration-fast"), easing, fill: "forwards" },
            );
            fade.finished
              .then(() => {
                // a later press took over while this one was fading out: it arranges the list
                if (run !== sorting) return;
                fade?.cancel();
                arrange(list, current);
                fade = list.animate([{ opacity: 0 }, { opacity: 1 }], {
                  duration: ms("--duration-medium"),
                  easing,
                });
              })
              .catch(() => {});
          },
          { signal },
        );
      }
      signal.addEventListener("abort", () => fade?.cancel());

      // the picture of the row under the mouse follows it, centred on the pointer; a row with none shows nothing
      if (thumb) {
        followPointer(thumb, list, signal, "center");
        list.addEventListener(
          "pointerover",
          (event) => {
            if (event.pointerType !== "mouse") return;
            const row = (event.target as Element).closest<HTMLElement>(
              ".archive-index_row",
            );
            const url = row?.dataset.thumb;
            if (!url) return thumb.removeAttribute("data-has");
            if (thumb.getAttribute("src") !== url) thumb.src = url;
            thumb.alt = "";
            thumb.setAttribute("data-has", "");
          },
          { signal },
        );
        list.addEventListener(
          "pointerleave",
          () => thumb.removeAttribute("data-has"),
          { signal },
        );

        // the pictures are fetched one after another once the page is quiet, so the first hover finds them (not on a touch screen, not with the data saver on)
        const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
        const saver = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
        if (fine && !saver && !reduce.matches) {
          const urls = [...list.querySelectorAll<HTMLElement>("[data-thumb]")]
            .map((row) => row.dataset.thumb as string)
            .filter(Boolean);
          let k = 0;
          const next = () => {
            if (signal.aborted || k >= urls.length) return;
            const image = new Image();
            image.decoding = "async";
            image.onload = image.onerror = () => idle(next);
            image.src = urls[k++];
          };
          const idle = (fn: () => void) =>
            "requestIdleCallback" in window
              ? requestIdleCallback(fn, { timeout: 2000 })
              : setTimeout(fn, 200);
          idle(next);
        }

        // a plain click on a row with its picture shown: that picture is the film that grows into the project's page (TransitionCustom)
        list.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey ||
              !thumb.hasAttribute("data-has") ||
              !(event.target as Element).closest(".archive-index_row")
            )
              return;
            thumb.classList.add("is-leaving");
          },
          { signal },
        );
        signal.addEventListener("abort", () => thumb.classList.remove("is-leaving"));
      }
    }
  });
</script>

<style is:global>
  @layer components {
    /* An index that reads like credits: year, client, project, industry on one line each, a hairline under each.
       The columns sit on the page grid (--site-columns, its gap --site-gutter, the nav's and About's): from 62rem the
       seven columns, year over the first two, client under the nav's links (third), project over the fifth and
       sixth, industry in the seventh; from 48rem the two grid columns each halved, so the client still starts at the
       middle of the screen; under that the two columns, year then client. */
    .archive-index_wrap {
      inline-size: 100%;
      --_cols: var(--site-columns);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      @media (48rem <= width < 62rem) {
        --_cols: 4;
      }
    }

    .archive-index_head,
    .archive-index_row {
      display: grid;
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      column-gap: var(--site-gutter);
      align-items: center;
    }

    .archive-index_wrap {
      & .year {
        grid-column: 1;
        @media (width >= 48rem) {
          grid-column: 1 / span 2;
        }
      }
      & .client {
        grid-column: 2;
        @media (width >= 48rem) {
          grid-column: 3;
        }
        @media (width >= 62rem) {
          grid-column: 3 / span 2;
        }
      }
      & .project {
        display: none;
        @media (width >= 48rem) {
          display: flex;
          grid-column: 4;
        }
        @media (width >= 62rem) {
          grid-column: 5 / span 2;
        }
      }
      & .industry {
        display: none;
        @media (width >= 62rem) {
          display: flex;
          grid-column: 7;
        }
      }
    }

    .archive-index_head {
      border-block-end: var(--border-width) solid var(--border);
    }

    .archive-index_item {
      border-block-end: var(--border-width) solid var(--border);
    }

    .archive-index_sort,
    .archive-index_row {
      min-block-size: 2.75rem;
      padding-block: var(--archive-row-pad);
    }

    .archive-index_sort {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: inherit;
      text-align: start;
      cursor: pointer;
      &:focus-visible {
        outline-offset: calc(var(--focus-offset) * -1);
      }
    }

    /* The sort's ring: on every heading, filled on the one in use */
    .archive-index_dot {
      flex: none;
      inline-size: 0.4em;
      block-size: 0.4em;
      border: var(--border-width) solid currentcolor;
      border-radius: var(--radius-round);
      background-color: transparent;
      transition: background-color var(--hover-duration) var(--hover-ease);
    }

    .archive-index_sort[aria-pressed="true"] .archive-index_dot {
      background-color: currentcolor;
    }

    .archive-index_list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .archive-index_row {
      color: inherit;
      text-decoration: none;
    }

    .archive-index_cell {
      min-inline-size: 0;
      overflow-wrap: anywhere;
    }

    /* Once the list has arrived (a sort moves the rows in the page, which would start their rise again) or when it comes back (the close of a project): the rows are there as they were left, none of the opening rise */
    .archive-index_wrap[data-settled] .rise {
      animation: none;
    }

    /* The picture that follows the mouse, on it: its own shape (a pill, a coin and a film frame are not alike), over everything, never in its way */
    .archive-index_thumb {
      display: block;
      inline-size: clamp(14rem, 20vw, 24rem);
      max-inline-size: 40vw;
      block-size: auto;
      &:not([data-has]) {
        opacity: 0;
      }
      &[data-on][data-has] {
        opacity: 1;
      }
      /* Followed by a plain click: it is the film that grows into the project's page (named as the film's own stage) */
      &.is-leaving {
        view-transition-name: film;
      }
    }
  }
</style>
