---
import type { HTMLAttributes } from "astro/types";

type Row = {
  /** The year, as four digits. */
  year: string;
  /** The client. */
  client: string;
  /** The project's title. */
  project: string;
  /** The industry: written the same way on every row, so the sort keeps them together. */
  industry: string;
  /** The project's page: /videos/koho. */
  href: string;
  /** The picture that follows the pointer over the row: a short muted loop or a WebP, never a GIF. */
  thumb?: string;
  /** What the picture shows, from the project's title and client. */
  thumbAlt?: string;
};

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The projects, newest first: the order the list opens in. */
  rows: Row[];
};

const { render = true, rows, class: className, ...rest } = Astro.props;

const columns = [
  { key: "year", label: "Year" },
  { key: "client", label: "Client" },
  { key: "project", label: "Project" },
  { key: "industry", label: "Industry" },
] as const;
---

{
  render && rows.length > 0 && (
    <div class:list={["archive-index_wrap", className]} {...rest}>
      {/* Sort by a heading: the active one carries a dot. Columns drop out on a small screen, as on the current site. */}
      <div
        class="archive-index_head dim-others"
        role="group"
        aria-label="Sort the list"
      >
        {columns.map((column, i) => (
          <button
            class={`archive-index_sort ${column.key}`}
            type="button"
            data-key={column.key}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {column.label}
            <span class="archive-index_dot" aria-hidden="true" />
          </button>
        ))}
      </div>

      <ul
        class="archive-index_list dim-others"
        data-op-list="archive"
        data-op-source="component:ArchiveIndex"
      >
        {rows.map((row, i) => (
          <li class="archive-index_item rise" style={`--i:${i}`} data-op-item>
            <a
              class="archive-index_row"
              href={row.href}
              data-thumb={row.thumb}
              data-alt={row.thumbAlt}
            >
              <span class="archive-index_cell year">{row.year}</span>
              <span class="archive-index_cell client">{row.client}</span>
              <span class="archive-index_cell project">{row.project}</span>
              <span class="archive-index_cell industry">{row.industry}</span>
            </a>
          </li>
        ))}
      </ul>

      <img
        class="archive-index_thumb pointer-follow"
        alt=""
        aria-hidden="true"
      />
      <p class="sr-only" role="status" aria-live="polite" />
    </div>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { followPointer } from "@/utils/pointer-follow.ts";

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>(
      ".archive-index_wrap",
    )) {
      // once per root: a copy made in OP System carries the attribute from its original
      if (root.dataset.scriptInitialized === "true") continue;
      root.dataset.scriptInitialized = "true";
      signal.addEventListener(
        "abort",
        () => delete root.dataset.scriptInitialized,
      );

      const list = root.querySelector<HTMLElement>(".archive-index_list");
      const sorts = [
        ...root.querySelectorAll<HTMLButtonElement>(".archive-index_sort"),
      ];
      const thumb = root.querySelector<HTMLImageElement>(
        ".archive-index_thumb",
      );
      const status = root.querySelector<HTMLElement>("[role=status]");
      if (!list) continue;

      // job: sort the list by the heading pressed; a second press on the same heading reverses it
      const names: Record<string, [string, string]> = {
        year: ["newest first", "oldest first"],
        client: ["A to Z", "Z to A"],
        project: ["A to Z", "Z to A"],
        industry: ["A to Z", "Z to A"],
      };
      let key = "year";
      let down = true; // the list opens newest first
      const text = (item: Element, k: string) =>
        item.querySelector(`.archive-index_cell.${k}`)?.textContent?.trim() ??
        "";

      const order = new Map([...list.children].map((item, i) => [item, i]));
      for (const sort of sorts) {
        sort.addEventListener(
          "click",
          () => {
            const next = sort.dataset.key ?? "year";
            down = next === key ? !down : next === "year";
            key = next;
            const items = [...list.children].sort((a, b) => {
              const [x, y] = [text(a, key), text(b, key)];
              const by =
                key === "year"
                  ? Number(x) - Number(y)
                  : x.localeCompare(y, undefined, { sensitivity: "base" });
              return (
                (down ? -by : by) || (order.get(a) ?? 0) - (order.get(b) ?? 0)
              );
            });
            list.append(...items);
            for (const other of sorts)
              other.setAttribute("aria-pressed", String(other === sort));
            if (status)
              status.textContent = `Sorted by ${sort.textContent?.trim()}, ${names[key][down ? 0 : 1]}`;
          },
          { signal },
        );
      }

      // the picture of the row under the mouse follows it; a row with none shows nothing
      if (thumb) {
        followPointer(thumb, list, signal, { x: 24, y: 24 });
        list.addEventListener(
          "pointerover",
          (event) => {
            if (event.pointerType !== "mouse") return;
            const row = (event.target as Element).closest<HTMLElement>(
              ".archive-index_row",
            );
            const url = row?.dataset.thumb;
            if (!url) return thumb.removeAttribute("data-has");
            if (thumb.getAttribute("src") !== url) thumb.src = url;
            thumb.alt = "";
            thumb.setAttribute("data-has", "");
          },
          { signal },
        );
        list.addEventListener(
          "pointerleave",
          () => thumb.removeAttribute("data-has"),
          { signal },
        );
      }
    }
  });
</script>

<style is:global>
  @layer components {
    /* An index that reads like credits: year, client, project, industry on one line each */
    .archive-index_wrap {
      inline-size: 100%;
      --_columns: 0.6fr 1.2fr 1.6fr 1fr;
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
      @media (width < 48rem) {
        --_columns: 0.6fr 1.2fr 1.6fr;
      }
      @media (width < 30rem) {
        --_columns: 0.6fr 1.4fr;
      }
    }

    .archive-index_head,
    .archive-index_row {
      display: grid;
      grid-template-columns: var(--_columns);
      column-gap: var(--site-gutter);
    }

    .archive-index_sort,
    .archive-index_row {
      min-block-size: 2.75rem;
      align-items: center;
    }

    .archive-index_sort {
      display: flex;
      gap: var(--space-2);
      color: inherit;
      text-align: start;
      cursor: pointer;
      &:focus-visible {
        outline-offset: calc(var(--focus-offset) * -1);
      }
    }

    /* The sort's dot: the site's one red mark, shown only on the heading in use */
    .archive-index_dot {
      flex: none;
      inline-size: 0.4em;
      block-size: 0.4em;
      border-radius: var(--radius-round);
      background-color: var(--heading-accent);
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
    }

    .archive-index_sort[aria-pressed="true"] .archive-index_dot {
      opacity: 1;
    }

    .archive-index_list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .archive-index_row {
      color: inherit;
      text-decoration: none;
    }

    .archive-index_cell {
      min-inline-size: 0;
      overflow-wrap: anywhere;
    }

    /* Columns that drop out of a small screen (the heading's and the rows') */
    .archive-index_wrap {
      & .project {
        @media (width < 30rem) {
          display: none;
        }
      }
      & .industry {
        @media (width < 48rem) {
          display: none;
        }
      }
    }

    /* The picture that follows the mouse: a fixed size, over everything, never in its way */
    .archive-index_thumb {
      inline-size: 20rem;
      max-inline-size: 40vw;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      &:not([data-has]) {
        opacity: 0;
      }
      &[data-on][data-has] {
        opacity: 1;
      }
    }
  }
</style>
