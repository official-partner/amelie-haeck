---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page (the home and the films), so the first section starts underneath it. */
  overlap?: boolean;
  /** The other language's page: its words and its address. The current site hides it everywhere, so it shows only when given. */
  language?: { label: string; href: string };
}

const {
  render = true,
  overlap = false,
  language,
} = Astro.props;

/* The current site's words, on every screen, never a hamburger: the name at the left, About over Work a quarter of the
   way across. The other language's link is the current site's too, but hidden there: it comes back with `language`. */
const links = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/archives" },
];
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <nav class="nav_inner" aria-label="Main">
        <a class="nav_name" href="/" aria-current={current("/")}>
          {SITE_NAME}
        </a>
        <ul class="nav_links">
          {links.map((link) => (
            <li>
              <a
                class="nav_link"
                href={link.href}
                aria-current={current(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        {language && (
          <a
            class="nav_link nav_language"
            href={language.href}
            hreflang={language.href.includes("fr") ? "fr" : "en"}
          >
            {language.label}
          </a>
        )}
      </nav>
    </header>
  )
}

<style is:global>
  @layer components {
    /* Text on the page's ground, never boxes. Over a film (overlap) it has no ground of its own. */
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      /* Holds still while the page changes (TransitionCustom) */
      view-transition-name: site-nav;

      &.overlap {
        position: fixed;
        inset-inline: 0;
        background-color: transparent;
      }
    }

    .nav_inner {
      width: 100%;
      display: grid;
      /* The links start at 26 % of the screen, as the current site's (24 % of its width for the name, and the margin): the nav's own width and its two margins are the screen's */
      grid-template-columns: minmax(max-content, calc((100% + var(--site-margin) * 2) * 0.24)) 1fr auto;
      align-items: start;
      column-gap: 0;
      padding-block-start: calc(var(--site-margin) * 1.1);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
    }

    .nav_name,
    .nav_link {
      display: inline-flex;
      align-items: center;
      min-block-size: 1.5rem;
      color: inherit;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }

    .nav_name {
      justify-self: start;
      padding-inline-end: var(--site-gutter);
      white-space: nowrap;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      justify-self: start;
    }

    .nav_language {
      justify-self: end;
    }
  }
</style>
