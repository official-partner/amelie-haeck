---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page (the home and the films), so the first section starts underneath it. */
  overlap?: boolean;
  /** The other language's page: its words and its address. */
  language?: { label: string; href: string };
}

const {
  render = true,
  overlap = false,
  language = { label: "Fr", href: "/contact-fr" },
} = Astro.props;

/* The current site's three words, in one row on every screen, never a hamburger: the name, then About and Work, then
   the other language at the edge. */
const links = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/archives" },
];
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <nav class="nav_inner" aria-label="Main">
        <a class="nav_name" href="/" aria-current={current("/")}>
          {SITE_NAME}
        </a>
        <ul class="nav_links">
          {links.map((link) => (
            <li>
              <a
                class="nav_link"
                href={link.href}
                aria-current={current(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          class="nav_link nav_language"
          href={language.href}
          hreflang={language.href.includes("fr") ? "fr" : "en"}
        >
          {language.label}
        </a>
      </nav>
    </header>
  )
}

<style is:global>
  @layer components {
    /* Text on the page's ground, never boxes. Over a film (overlap) it has no ground of its own. */
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      /* Holds still while the page changes (TransitionCustom) */
      view-transition-name: site-nav;

      &.overlap {
        position: fixed;
        inset-inline: 0;
        background-color: transparent;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: var(--site-gutter);
      min-block-size: var(--nav-height);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
    }

    .nav_name,
    .nav_link {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      color: inherit;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }

    .nav_name {
      justify-self: start;
      white-space: nowrap;
    }

    .nav_links {
      display: flex;
      justify-self: center;
      gap: var(--site-gutter);
    }

    .nav_language {
      justify-self: end;
    }
  }
</style>
