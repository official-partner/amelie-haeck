---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page (the home and the films), so the first section starts underneath it. */
  overlap?: boolean;
  /** The other language's page: its words and its address. The current site hides it everywhere, so it shows only when given. */
  language?: { label: string; href: string };
}

const {
  render = true,
  overlap = false,
  language,
} = Astro.props;

/* The current site's words, on every screen, never a hamburger: the name at the left, About over Work a quarter of the
   way across. The other language's link is the current site's too, but hidden there: it comes back with `language`. */
const links = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/work" },
];
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
/* Work is the current page on a project's page too: the project is one of its films */
const current = (href: string) =>
  path === href || (href === "/work" && path.startsWith("/videos/"))
    ? "page"
    : undefined;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <nav class="nav_inner" aria-label="Main">
        <a class="nav_name" href="/" aria-current={current("/")}>
          {SITE_NAME}
        </a>
        <ul class="nav_links">
          {links.map((link) => (
            <li>
              <a
                class="nav_link"
                href={link.href}
                aria-current={current(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        {language && (
          <a
            class="nav_link nav_language"
            href={language.href}
            hreflang={language.href.includes("fr") ? "fr" : "en"}
          >
            {language.label}
          </a>
        )}
      </nav>
    </header>
  )
}

<style is:global>
  @layer components {
    /* Text on the page's ground, never boxes. Over a film (overlap) it has no ground of its own. */
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      /* no ground of its own: the words sit straight on the page */
      color: var(--text);
      /* Holds still while the page changes (TransitionCustom) */
      view-transition-name: site-nav;
      /* The bar is empty space between its words: what is under it (a film's Sound Off and X) stays clickable */
      pointer-events: none;

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      display: grid;
      /* The page grid: the links start in its third column (the second on a phone, at half the screen), the language link ends in the last */
      grid-template-columns: repeat(var(--site-columns), minmax(0, 1fr));
      align-items: start;
      column-gap: var(--site-gutter);
      padding-block-start: calc(var(--site-margin) * 1.2);
      font-size: var(--text-main);
      line-height: var(--text-main-line-height);
    }

    .nav_name,
    .nav_link {
      display: inline-flex;
      align-items: center;
      min-block-size: 1.5rem;
      color: inherit;
      text-decoration: none;
      pointer-events: auto;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      &:focus-visible {
        color: var(--text-2);
      }
    }

    .nav_name {
      grid-column: 1;
      justify-self: start;
      white-space: nowrap;
      @media (width >= 62rem) {
        grid-column: 1 / span 2;
      }
    }

    .nav_links {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      justify-self: start;
      @media (width >= 62rem) {
        grid-column: 3;
      }
    }

    .nav_language {
      grid-column: -2 / -1;
      justify-self: end;
    }
  }
</style>
