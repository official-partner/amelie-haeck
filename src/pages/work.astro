---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ArchiveIndex from "@/components/content/ArchiveIndex.astro";
import { getWorkRows } from "@/utils/projects";

/* The projects collection's items marked « Dans la liste Work » (src/content/projects/, OP System's Contenu) */
const rows = await getWorkRows();
---

<Layout
  theme="signal"
  title="Work"
  description="The films of Amélie Haeck, motion designer in Montreal, by year, client, project and industry."
>
  <h1 class="sr-only">Work</h1>
  <Section paddingTop="none" paddingBottom="none">
    <ArchiveIndex
      rows={rows}
      list="projects"
      source="astro:projects"
      style="padding-block: var(--page-top) var(--page-bottom)"
    />
  </Section>
</Layout>
