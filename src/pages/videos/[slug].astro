---
import Layout from "@/layouts/BaseLayout.astro";
import FilmPlayer from "@/components/content/FilmPlayer.astro";
import { getItem } from "@/utils/content";
import { getProjects, creditOf, noteOf, fileOf } from "@/utils/projects";

/* A project's page, one per visible item of the projects collection (src/content/projects/<slug>.json), at the
   current site's address /videos/<slug>. Built once per item on main; rendered on demand on the staging, where an
   item added in Contenu has its page at once. */
export async function getStaticPaths() {
  return (await getProjects()).map(({ id }) => ({ params: { slug: id } }));
}

const { slug } = Astro.params;
const project = slug ? await getItem("projects", slug) : undefined;
// no visible item of that name (on the staging, rendered on demand): the site's 404 page, with its status
if (!project) return new Response(null, { status: 404 });

const { data } = project;
const other = data.otherPart ? await getItem("projects", data.otherPart.id) : undefined;
const credits = (data.credits ?? []).map(creditOf).filter((c) => c.role || c.name);
const description =
  data.seoDescription ||
  [
    `${data.title}, a film by Amélie Haeck, motion designer in Montreal`,
    data.client && data.client !== data.title && data.client !== "Amélie Haeck"
      ? ` for ${data.client}`
      : "",
    data.year ? `, ${data.year}` : "",
    ".",
  ].join("");
---

<Layout
  overlap
  title={data.title}
  seoTitle={data.seoTitle}
  description={description}
  image={fileOf(data.ogImage)}
>
  <FilmPlayer
    title={data.title}
    src={data.film}
    credits={credits}
    creditsSource={`src/content/projects/${project.id}.json`}
    note={noteOf(data.creditsNote, data.creditsLink)}
    part={
      other
        ? {
            href: `/videos/${other.id}`,
            label: data.otherPartLabel || other.data.title,
          }
        : undefined
    }
  />
</Layout>
