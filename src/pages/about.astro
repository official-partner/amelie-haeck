---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import AboutSheet from "@/components/section/AboutSheet.astro";
import Statement from "@/components/content/Statement.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import NameList from "@/components/content/NameList.astro";
import RoleList from "@/components/content/RoleList.astro";
import { statement, email, clients, partners, contact } from "@/data/about.ts";
---

<Layout
  theme="signal"
  title="About"
  description="Amélie Haeck is a motion designer based in Montreal. Her clients, her creative partners and how to write to her."
>
  <Section paddingTop="none" paddingBottom="none">
    <AboutSheet>
      <Statement slot="head" lines={statement} email={email} />
      <Accordion single={false} openFirst>
        <AccordionItem heading="Selected Clients" variant="dot">
          <NameList names={clients} data-op-list="clients" data-op-source="src/data/about.ts" />
        </AccordionItem>
        <AccordionItem heading="Creative Partners" variant="dot">
          <RoleList rows={partners} data-op-list="partners" data-op-source="src/data/about.ts" />
        </AccordionItem>
        <AccordionItem heading="Send love letters" variant="dot">
          <RoleList rows={contact} data-op-list="contact" data-op-source="src/data/about.ts" />
        </AccordionItem>
      </Accordion>
    </AboutSheet>
  </Section>
</Layout>
